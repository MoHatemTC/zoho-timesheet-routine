# Zoho People login. Copy this file to .env and fill it in. NEVER commit .env.
# Routines: set the same keys as environment variables instead (no .env file).

# Region from your Zoho People address: people.zoho.com -> com, .eu -> eu, .in -> in, .sa -> sa
ZOHO_DC=com

# api-console.zoho.<ZOHO_DC> -> Self Client -> "Client Secret" tab
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# The email you log time with in Zoho People
ZOHO_USER_EMAIL=

# ONE-TIME code, used once to get ZOHO_REFRESH_TOKEN below. Skip it if you already have a refresh token.
# Self Client -> "Generate Code" tab, scope: ZOHOPEOPLE.timetracker.ALL
# It expires in minutes: paste it, save, then IMMEDIATELY run  python scripts/zoho_auth.py
ZOHO_GRANT_CODE=

# Your permanent key, filled in by scripts/zoho_auth.py. Copy it into the routine's environment variables.
ZOHO_REFRESH_TOKEN=
