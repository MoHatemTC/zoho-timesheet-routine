# Zoho People + Zoho Projects API credentials — copy to .env and fill in. NEVER commit .env.
# Cloud routines: set these as environment variables instead (no .env file).

# ── 1. Region ────────────────────────────────────────────────────────────────
# Open Zoho People in your browser and look at the domain:
#   people.zoho.com -> com     people.zoho.sa -> sa     people.zoho.eu -> eu
#   people.zoho.in  -> in      people.zoho.com.au -> com.au
ZOHO_DC=com

# ── 2. Self Client keys ──────────────────────────────────────────────────────
# api-console.zoho.<ZOHO_DC>  ->  Self Client  ->  "Client Secret" tab
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ── 3. One-time grant code ───────────────────────────────────────────────────
# Self Client -> "Generate Code" tab, scope (paste whole line):
#   ZOHOPEOPLE.timetracker.ALL,ZohoProjects.portals.READ,ZohoProjects.projects.READ,ZohoProjects.tasklists.READ,ZohoProjects.tasks.READ,ZohoProjects.users.READ,ZohoProjects.timesheets.READ
# It expires in minutes: paste it, save this file, then IMMEDIATELY run
#     python zoho_auth.py
ZOHO_GRANT_CODE=

# ── 4. Filled in automatically by zoho_auth.py — leave empty ─────────────────
ZOHO_REFRESH_TOKEN=

# The Zoho People user the time is logged for.
ZOHO_USER_EMAIL=

# ── 5. Zoho Projects portal (People projects are synced from it) ─────────────
ZOHO_PROJECTS_PORTAL_ID=782665901

# ── 6. Google Calendar (read-only) ───────────────────────────────────────────
# Google Calendar -> Settings -> your calendar -> "Integrate calendar"
#   -> "Secret address in iCal format". Treat it like a password.
GOOGLE_CALENDAR_ICS_URL=
