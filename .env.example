# Zoho People login. Copy this file to .env and fill it in. NEVER commit .env.
# Routines: set the same keys as environment variables instead (no .env file).

# Region from your Zoho People address: people.zoho.com -> com, .eu -> eu, .in -> in, .sa -> sa
ZOHO_DC=com

# api-console.zoho.<ZOHO_DC> -> Self Client -> "Client Secret" tab
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# The email you log time with in Zoho People
ZOHO_USER_EMAIL=

# Self Client -> "Generate Code" tab, scope: ZOHOPEOPLE.timetracker.ALL
# It expires in minutes: paste it, save, then IMMEDIATELY run  python zoho_auth.py
ZOHO_GRANT_CODE=

# Filled in by zoho_auth.py — copy it into the routine's environment variables
ZOHO_REFRESH_TOKEN=
